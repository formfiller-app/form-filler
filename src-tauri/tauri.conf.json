{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Form Filler",
  "version": "../package.json",
  "identifier": "io.github.formfiller-app.form-filler",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' data: ipc: http://ipc.localhost",
        "manifest-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Fill hard forms easily, and keep every paper",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false,
      "scopeDroppedPaths": false
    }
  }
}
